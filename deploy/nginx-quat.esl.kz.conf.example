# Example Nginx site for quat.esl.kz
# Do NOT enable blanket proxy_cache. Honor upstream Cache-Control.
# Authenticated HTML/API and Set-Cookie responses must not be shared-cached.

upstream quathub_app {
  server 127.0.0.1:35305;
  keepalive 32;
}

server {
  listen 443 ssl http2;
  server_name quat.esl.kz;

  # ssl_certificate / etc/letsencrypt/live/quat.esl.kz/fullchain.pem;
  # ssl_certificate_key /etc/letsencrypt/live/quat.esl.kz/privkey.pem;

  location /_next/static/ {
    proxy_pass http://quathub_app;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    # Prefer upstream Cache-Control (immutable hashed assets)
    proxy_hide_header X-Powered-By;
  }

  location / {
    proxy_pass http://quathub_app;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Connection "";

    # Never shared-cache responses that set cookies (sessions)
    proxy_ignore_headers Set-Cookie;
    # Do not add proxy_cache here for the whole site.
  }
}
